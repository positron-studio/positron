{
  // positron-cast: Väin's archive played live into an Icecast mount, or into our own preview Icecast.
  // The audio source is a container on the Caster class (durable_object policy, size in code: CAST_INSTANCE).
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "positron-cast",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "cast.positron.studio", "custom_domain": true }],
  "containers": [
    {
      "class_name": "Caster",
      "scheduling_policy": "durable_object",
      // build context is this directory, so the image copies the one mp3.mjs; Debian since stage 2 (scsynth, JACK)
      "images": { "cast": { "dockerfile": "./container/Dockerfile.grains", "build_context": "." } }
    }
  ],
  "durable_objects": { "bindings": [{ "name": "CASTER", "class_name": "Caster" }, { "name": "VOTES", "class_name": "Votes" }] },
  // v2: the `test` receiver (Rx) is gone with the `test` target; it kept nothing in storage
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Caster", "Rx"] }, { "tag": "v2", "deleted_classes": ["Rx"] }, { "tag": "v3", "new_sqlite_classes": ["Votes"] }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // the shout relay's tee stats, to count who hears radio1965 and preview through it (listeners.mjs)
  "services": [{ "binding": "SHOUT", "service": "positron-shout" }],
  "workers_dev": true,
  "observability": { "enabled": true }
}
