// chamber: the cast's engine (the wasm scsynth, the ring, the layers, the master) in a Durable Object; named castlab while a throwaway experiment.
// node gen-glue.mjs first; then wrangler dev, or wrangler deploy once and wrangler delete after.
{
  "name": "positron-chamber",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "CHAMBER", "class_name": "Chamber" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Chamber"] }],
  "observability": { "enabled": true }
}
