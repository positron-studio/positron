// positron-sfu: Cloudflare Realtime SFU for the /room/ demos (worker.mjs). Secrets, never in this file:
// wrangler secret put CF_REALTIME_APP_SECRET and SFU_PROOF_KEY. The app id is not a credential.
{
  "name": "positron-sfu",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "routes": [{ "pattern": "sfu.positron.studio", "custom_domain": true }],
  "vars": { "CF_REALTIME_APP_ID": "8c2a974bb21528d398ff927116bcca9e" },
  // LIVE: one per room, the room's live WHIP input (worker.mjs Live).
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "Live" }] },
  // v1 and v3: the film container (2026-10-22), replaced by the WHIP input the same day.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Film"] }, { "tag": "v2", "new_sqlite_classes": ["Live"] }, { "tag": "v3", "deleted_classes": ["Film"] }],
  "observability": { "enabled": true }
}
