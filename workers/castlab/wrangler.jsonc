// castlab: a throwaway experiment (the cast's wasm engine in a Durable Object). No routes, no custom domain.
// node gen-glue.mjs first; then wrangler dev, or wrangler deploy once and wrangler delete after.
{
  "name": "positron-castlab",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "LAB", "class_name": "CastLab" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CastLab"] }],
  "observability": { "enabled": true }
}
