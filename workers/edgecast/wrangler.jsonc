// edgecast: the cast's engine (the wasm scsynth, the ring, the layers, the master) in a Durable Object; named castlab while a throwaway experiment.
// /radio/edgecast/ is its page. node gen-glue.mjs first; then wrangler dev, or wrangler deploy. Idle, it costs nothing.
{
  "name": "positron-edgecast",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "routes": [{ "pattern": "edgecast.positron.studio", "custom_domain": true }],
  "durable_objects": { "bindings": [{ "name": "EDGECAST", "class_name": "Edgecast" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Edgecast"] }],
  "observability": { "enabled": true }
}
